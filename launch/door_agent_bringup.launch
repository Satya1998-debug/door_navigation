<?xml version="1.0"?>
<!--
    Agent-side bringup for the door navigation stack.

    Starts (in one shot):
      1. rosbridge_websocket    (so robotdog_guide can reach ROS)
      2. Camera + door pipeline (via door_navigation.launch)
      3. robot_command_bridge   (exposes /agent/start_navigation)

    NOT started by this file (start them separately, before this):
      - roscore
      - Base navigation stack (move_base + localization)
-->
<launch>

    <arg name="rosbridge_port"          default="9090"/>
    <arg name="rosbridge_address"       default=""/>  <!-- empty => bind to all interfaces -->
    <arg name="nav_wait_timeout_sec"    default="300"/>
    <arg name="nav_position_tolerance"  default="0.15"/>

    <!-- 1. rosbridge websocket for the LLM agent -->
    <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
        <arg name="port"    value="$(arg rosbridge_port)"/>
        <arg name="address" value="$(arg rosbridge_address)"/>
    </include>

    <!-- 2. Camera + door detector/pose estimator + state estimator + coordinator -->
    <include file="$(find door_navigation)/launch/door_navigation.launch"/>

    <!-- 3. Agent-facing service /agent/start_navigation -->
    <node pkg="door_navigation" type="robot_command_bridge.py"
          name="robot_command_bridge" output="screen" required="true">
        <param name="nav_wait_timeout_sec"   value="$(arg nav_wait_timeout_sec)"/>
        <param name="nav_position_tolerance" value="$(arg nav_position_tolerance)"/>
    </node>

</launch>
