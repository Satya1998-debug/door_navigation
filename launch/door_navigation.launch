<?xml version="1.0"?>
<launch>

    <!-- Door Detector & Pose Estimator Node -->
    <node pkg="door_navigation" type="door_detect_pose_estimate_node.py" name="door_detect_pose_estimate_node" output="screen"/>
    
    <!-- Door State Estimator Service -->
    <node pkg="door_navigation" type="door_state_estimator_node.py" name="door_state_estimator_service" output="screen"/>
    
    <!-- Door Coordinator Node -->
    <node pkg="door_navigation" type="door_coordinator_node.py" name="door_coordinator_node" output="screen"/>
    
</launch>
